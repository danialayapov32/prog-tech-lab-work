import matplotlib.pyplot as plt

class ChartSaver:
    def save_with_labels(self, df, preset):
        x_name = preset['x']
        y_name = preset['y']

        plt.xlabel(x_name)
        plt.ylabel(y_name)

        output_file = "out.png"
        plt.savefig(output_file)
        plt.close()

        return output_file
